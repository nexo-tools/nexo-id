APP_NAME="Nexo ID"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nexoid@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Unique per tool so every Nexo app can run at once (map in dev-environment).
APP_PORT=8100
VITE_PORT=5175

# Attribution footer (per-instance branding). Empty → neutral product defaults
# (see config/nexo.php). Set both on a hosted instance, e.g.
#   NEXO_ATTRIBUTION_LABEL="powered by example.com"
#   NEXO_ATTRIBUTION_URL="https://example.com"
# Attribution shown in the footer. Leave unset and the tool shows its own
# neutral default ("made with Nexo ID"). A third-party instance must NOT advertise
# the upstream author; set your own here.
# NEXO_ATTRIBUTION_LABEL="powered by yoursite.com"
# NEXO_ATTRIBUTION_URL="https://yoursite.com"

# Legal pages (/privacidad, /terminos): who operates THIS instance and where to
# reach them. Unset → the pages omit that section. Every instance is its own data
# controller, so a self-host must set its own and never inherit the upstream one.
# NEXO_LEGAL_OPERATOR="Your name or company"
# NEXO_LEGAL_CONTACT="privacy@yoursite.com"

# Ecosystem chrome (app-switcher / footer). This tool's key; null hides the
# ecosystem identity for a plain standalone self-host. Tool URLs are
# env-overridable (see config/nexo-ecosystem.php) so self-hosters can point at
# their own instances.
NEXO_ECOSYSTEM_CURRENT=nexoid

# Cookieless ecosystem analytics (opt-in). Off by default; when true, an
# anonymous pageview beacon is sent to the Nexo Tools hub. See config/nexo.php.
NEXO_BEACON_ENABLED=false

# OIDC discovery forces https by default. Set false only for local http dev;
# production must keep it true.
OPENID_FORCE_HTTPS=false
